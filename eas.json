{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
	        "android": {
          "buildType": "apk"
        }
    },
    "production": {
      "autoIncrement": true,
	      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"}
    }
  },
  "submit": {
    "production": {}
  }
}
